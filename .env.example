# 복사: cp .env.example .env  (값 안 채워도 바로 동작 — 아래 참고)
# ─────────────────────────────────────────────────────────────────
# 심사 백엔드: 기본 auto
#   - ANTHROPIC_API_KEY 있으면 → API 직접 호출
#   - 없으면 → 로그인된 claude CLI 로 Claude 구독 공유 사용 (키 불필요)
#   강제 지정: cli | api | mock
# JUDGE_BACKEND=auto

# [선택] Anthropic API 키. 비워두면 claude CLI(구독)로 심사하므로 불필요.
#        발급: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# [선택] claude CLI 실행 경로 (PATH 에 있으면 불필요)
# CLAUDE_BIN=claude

# 심사 모델 (API/CLI 공통; CLI 는 opus/sonnet/haiku 별칭으로 자동 변환)
JUDGE_MODEL=claude-opus-4-8
SIM_MODEL=claude-sonnet-4-6

# 구글폼 연동 시트 CSV export (gid 포함). 시트 "링크가 있는 모든 사용자=뷰어" 필요.
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1odEggEuF2E6znnAN4rHF5pIbcoR_dbt6MgD8JloSfzU/export?format=csv&gid=1041254954
